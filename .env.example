# ============================================================
# Heliograph — Environment Configuration
# ============================================================
# This file holds ONLY :
#   - secrets (API keys)
#   - host-side paths used by docker compose to bind-mount volumes
#   - host-side ports
#   - container lifecycle env vars (intervals)
#
# Everything else (models, RAG settings, agents, retry policy, scanning…)
# lives in config.yaml. There is no overlap : a value belongs to exactly
# one of those two files.
# ============================================================

# ── Secrets (required) ─────────────────────────────────────
# OpenAI-compatible API endpoint (OpenAI, Mistral, vLLM, Ollama, LiteLLM, Azure…)
API_BASE_URL=https://api.example.com/v1
API_KEY=your-api-key

# ── Docker image ───────────────────────────────────────────
DOCKER_IMAGE=heliograph:latest

# ── Host ports ─────────────────────────────────────────────
WEB_PORT=8080
OPENWEBUI_PORT=3000
OPENWEBUI_SECRET_KEY=change-me-with-openssl-rand-hex-32

# ── Container lifecycle ────────────────────────────────────
# How often the indexer container re-scans the workspace.
INDEXER_INTERVAL_SECONDS=3600

# ── Host paths for bind mounts ─────────────────────────────
# All paths are relative to docker-compose.yml location.
HOST_WORKSPACE_PATH=./workspace
HOST_VECTORDB_PATH=./.vectordb
HOST_GRAPHDB_PATH=./.graphdb
HOST_CONTEXT_PATH=./context
HOST_AGENTS_PATH=./agents
HOST_REPORTS_PATH=./reports
HOST_OUTPUT_PATH=./output
HOST_WEBLOGS_PATH=./web/logs
HOST_PROJECTS_PATH=./projects
