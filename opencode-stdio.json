{
  "$schema": "https://opencode.ai/config.json",
  "//": "stdio mode: opencode spawns the MCP server as subprocess. Adjust 'cwd' to your agent-hub clone.",
  "mcp": {
    "agent-hub": {
      "type": "local",
      "command": ["python", "-m", "src.mcp.transports.stdio"],
      "enabled": true,
      "environment": {
        "PYTHONPATH": "/path/to/agent-hub"
      }
    }
  }
}
