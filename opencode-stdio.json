{
  "$schema": "https://opencode.ai/config.json",
  "//": "stdio mode: opencode spawns the MCP server as subprocess. Adjust 'cwd' to your heliograph clone.",
  "mcp": {
    "heliograph": {
      "type": "local",
      "command": ["python", "-m", "src.mcp.transports.stdio"],
      "enabled": true,
      "environment": {
        "PYTHONPATH": "/path/to/heliograph"
      }
    }
  }
}
